# Server
PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Security (required)
JWT_SECRET=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-another-random-secret

# OTP behavior
OTP_EXPIRY_MINUTES=10
JWT_SIGNUP_PROOF_EXPIRY=15m
REQUIRE_EMAIL_OTP=false

# Optional email provider (Resend)
# If not provided, OTP codes are logged to backend console in local development.
RESEND_API_KEY=re_4cahn14kW_P1KbGPfLkPzAb5XJ7wXNSvw5
RESEND_FROM_EMAIL=Campus Connect <onboarding@resend.dev>
RESEND_AUDIENCE_NAME=Campus Connect

# Oracle Database
ORACLE_USER=campus_connect
ORACLE_PASSWORD=your-oracle-password
ORACLE_CONNECTION_STRING=localhost:1521/XEPDB1
ORACLE_POOL_ALIAS=campus_connect_pool
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1
ORACLE_STMT_CACHE_SIZE=40

# Frontend
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5500

# JWT
JWT_EXPIRES_IN=7d
